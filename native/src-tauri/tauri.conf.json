{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garcon",
  "version": "../../package.json",
  "identifier": "com.garconcloud.garcon",
  "build": {
    "beforeDevCommand": "bun run build",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": { "minimumSystemVersion": "17.4" },
    "macOS": { "minimumSystemVersion": "14.4" }
  }
}
