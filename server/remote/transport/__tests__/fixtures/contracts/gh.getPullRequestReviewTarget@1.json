            "union": [
              "null",
              {
                "id": "string",
                "login": "string"
              }
            ]
          },
          "id": "string",
          "isMinimized": {
            "union": [
              "false",
              "true"
            ]
          },
          "marker": "string",
          "url": "string"
        }
      },
      "number": "number",
      "repository": {
        "host": "string",
        "nameWithOwner": "string"
      },
      "state": {
