                "bisectionCount?": {
                  "union": [
                    "number",
                    "undefined"
                  ]
                },
                "cacheHits?": {
                  "union": [
                    "number",
                    "undefined"
                  ]
                },
                "commands": {
                  "array": {
                    "command": "string",
                    "durationMs": "number",
                    "stderrBytes": "number",
                    "stdoutBytes": "number"
                  }
                },
                "fileCount?": {
                  "union": [
                    "number",
                    "undefined"
                  ]
