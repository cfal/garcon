{
  "definition": {
    "name": "git.getRemoteStatus",
    "version": 1,
    "requires": [
      {
        "name": "calls.reconcile",
        "version": 1,
        "requires": []
      }
    ],
    "lane": "bulk",
    "continuity": "journaled",
    "direction": "controller-to-worker"
  },
  "wire": {
    "request": {
      "budgetMs": "number",
      "input": {
        "projectPath": "string"
      }
    },
    "result": {
      "ahead?": {
        "union": [
          "number",
          "undefined"
        ]
      },
      "behind?": {
        "union": [
          "number",
          "undefined"
        ]
      },
      "branch": "string",
      "diagnostics?": {
        "union": [
          "undefined",
          {
            "batchCount?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "bisectionCount?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "cacheHits?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "commands": {
              "array": {
                "command": "string",
                "durationMs": "number",
                "stderrBytes": "number",
                "stdoutBytes": "number"
              }
            },
            "fileCount?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "phases": {
              "array": {
                "durationMs": "number",
                "name": {
                  "union": [
                    "\"body-cache\"",
                    "\"body-git\"",
                    "\"body-split\"",
                    "\"document-register\"",
                    "\"freshness-after\"",
                    "\"freshness-before\"",
                    "\"patch-scan\"",
                    "\"resolve\"",
                    "\"serialize\"",
                    "\"summary-git\""
                  ]
                }
              }
            },
            "rowCount?": {
              "union": [
                "number",
                "undefined"
              ]
            }
          }
        ]
      },
      "executorId": "string",
      "hasRemote": {
        "union": [
          "false",
          "true"
        ]
      },
      "hasUpstream": {
        "union": [
          "false",
          "true"
        ]
      },
      "instanceId": "string",
      "isUpToDate?": {
        "union": [
          "false",
          "true",
          "undefined"
        ]
      },
      "message?": {
        "union": [
          "string",
          "undefined"
        ]
      },
      "remoteBranch?": {
        "union": [
          "string",
          "undefined"
        ]
      },
      "remoteName": {
        "union": [
          "null",
          "string"
        ]
      }
    }
  },
  "failures": "rpc-errors-v1"
}
