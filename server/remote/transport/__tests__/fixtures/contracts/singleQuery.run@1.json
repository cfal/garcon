{
  "definition": {
    "name": "singleQuery.run",
    "version": 1,
    "requires": [
      {
        "name": "calls.reconcile",
        "version": 1,
        "requires": []
      }
    ],
    "lane": "primary",
    "continuity": "journaled",
    "direction": "controller-to-worker"
  },
  "wire": {
    "request": {
      "endpoint": {
        "union": [
          "null",
          {
            "apiProviderId": "string",
            "baseUrl": "string",
            "capabilities": {
              "union": [
                "null",
                {
                  "chatCompletions": {
                    "union": [
                      "false",
                      "true"
                    ]
                  },
                  "responses": {
                    "union": [
                      "false",
                      "true"
                    ]
                  }
                }
              ]
            },
            "credential": {
              "union": [
                "null",
                {
                  "apiProviderId": "string",
                  "endpointId": "string",
                  "kind": "\"api-provider-endpoint\"",
                  "revision": "number"
                }
              ]
            },
            "endpointId": "string",
            "headers": {
              "[string]": "string"
            },
            "isLocal": {
              "union": [
                "false",
                "true"
              ]
            },
            "model": "string",
            "protocol": {
              "union": [
                "\"anthropic-messages\"",
                "\"openai-compatible\""
              ]
            },
            "providerLabel": "string"
          }
        ]
      },
      "model": "string",
      "prompt": "string",
      "settings": {
        "ownerId": "string",
        "schemaVersion": "number",
        "values": {
          "[string]": {
            "union": [
              "false",
              "null",
              "number",
              "string",
              "true",
              {
                "array": {
                  "recursive": "JsonValue"
                }
              },
              {
                "recursive": "JsonObject"
              }
            ]
          }
        }
      },
      "thinkingMode": {
        "union": [
          "\"high\"",
          "\"low\"",
          "\"max\"",
          "\"medium\"",
          "\"none\"",
          "\"ultra\"",
          "\"xhigh\""
        ]
      },
      "timeoutMs?": {
        "union": [
          "number",
          "undefined"
        ]
      }
    },
    "result": "string"
  },
  "failures": "rpc-errors-v1"
}
