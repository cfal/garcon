{
  "definition": {
    "name": "git.getHistoryCommits",
    "version": 1,
    "requires": [
      {
        "name": "calls.reconcile",
        "version": 1,
        "requires": []
      }
    ],
    "lane": "bulk",
    "continuity": "journaled",
    "direction": "controller-to-worker"
  },
  "wire": {
    "request": {
      "budgetMs": "number",
      "input": {
        "limit?": {
          "union": [
            "number",
            "undefined"
          ]
        },
        "offset?": {
          "union": [
            "number",
            "undefined"
          ]
        },
        "projectPath": "string",
        "ref?": {
          "union": [
            "string",
            "undefined"
          ]
        }
      }
    },
    "result": {
      "commits": {
        "array": {
          "author": "string",
          "authorDate": "string",
          "authorEmail": "string",
          "committer": "string",
          "committerDate": "string",
          "committerEmail": "string",
          "hash": "string",
          "parents": {
            "array": "string"
          },
          "refs": {
            "array": "string"
          },
          "shortHash": "string",
          "subject": "string"
        }
      },
      "diagnostics?": {
        "union": [
          "undefined",
          {
            "batchCount?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "bisectionCount?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "cacheHits?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "commands": {
              "array": {
                "command": "string",
                "durationMs": "number",
                "stderrBytes": "number",
                "stdoutBytes": "number"
              }
            },
            "fileCount?": {
              "union": [
                "number",
                "undefined"
              ]
            },
            "phases": {
              "array": {
                "durationMs": "number",
                "name": {
                  "union": [
                    "\"body-cache\"",
                    "\"body-git\"",
                    "\"body-split\"",
                    "\"document-register\"",
                    "\"freshness-after\"",
                    "\"freshness-before\"",
                    "\"patch-scan\"",
                    "\"resolve\"",
                    "\"serialize\"",
                    "\"summary-git\""
                  ]
                }
              }
            },
            "rowCount?": {
              "union": [
                "number",
                "undefined"
              ]
            }
          }
        ]
      },
      "executorId": "string",
      "instanceId": "string",
      "nextOffset": {
        "union": [
          "null",
          "number"
        ]
      },
      "project": "string",
      "ref": "string"
    }
  },
  "failures": "rpc-errors-v1"
}
