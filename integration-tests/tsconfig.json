{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["@types/bun", "../web/node_modules/svelte"],
    "paths": { "$shared/*": ["../common/*"], "$lib/*": ["../web/src/lib/*"] }
  },
  "include": ["./**/*.ts", "../common/**/*.ts"],
  "exclude": ["node_modules"]
}
