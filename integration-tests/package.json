{
  "name": "@garcon/integration-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run test:server",
    "test:server": "bun test --max-concurrency=1 --timeout=30000 tests/server && bun run test:sacs",
    "test:sacs": "bun test --max-concurrency=1 --timeout=120000 tests/sacs",
    "test:e2e": "bun test --max-concurrency=1 --timeout=60000 tests/e2e",
    "test:chromium": "bun ../scripts/run-test-files.js 'tests/chromium/*.test.ts' --max-concurrency=1 --timeout=120000",
    "test:search-gate": "bun test --max-concurrency=1 --timeout=900000 tests/search-gate/transcript-search-v9-scale-gate.test.ts",
    "test:search-endurance": "bun test --max-concurrency=1 --timeout=2400000 tests/search-gate/transcript-search-v9-endurance.test.ts",
    "test:live": "bun run test:live:claude && bun run test:live:codex && bun run test:live:opencode",
    "test:live:claude": "bun test --max-concurrency=1 --timeout=120000 tests/live/claude",
    "test:live:codex": "bun test --max-concurrency=1 --timeout=240000 tests/live/codex",
    "test:live:opencode": "bun test --max-concurrency=1 --timeout=180000 tests/live/opencode",
    "typecheck": "bunx tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.220",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@openai/codex": "0.146.0",
    "@types/bun": "1.3.14",
    "opencode-ai": "1.18.4",
    "playwright": "1.61.1",
    "puppeteer-core": "25.3.0",
    "typescript": "7.0.2"
  }
}
