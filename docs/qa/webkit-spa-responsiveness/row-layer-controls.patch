@@ -0,0 +1,31 @@
+import { MemoryCache, type Token } from '@humanspeak/svelte-markdown';
+
+const MAX_SOURCE_LENGTH = 4096;
+const MAX_TOKENS = 128;
+const paragraphs = new MemoryCache<readonly string[]>({ maxSize: 128, ttl: 5 * 60_000 });
+
+export function simpleMarkdownKey(
+	source: string,
+	breaks: boolean,
+	bareChatReferences: boolean,
+): string | undefined {
+	if (!source.length || source.length > MAX_SOURCE_LENGTH) return undefined;
+	return `${Number(breaks)}${Number(bareChatReferences)}:${source}`;
+}
+
+export function cachedMarkdownParagraphs(key: string): readonly string[] | undefined {
+	return paragraphs.get(key);
+}
+
+export function rememberMarkdownParagraphs(key: string, tokens: readonly Token[]): void {
+	if (tokens.length > MAX_TOKENS) return;
+	const text: string[] = [];
+	for (const block of tokens) {
+		if (block.type === 'space') continue;
+		if (block.type !== 'paragraph' || ('imageOnly' in block && block.imageOnly) || block.tokens?.length !== 1) return;
+		const leaf = block.tokens[0];
+		if (leaf.type !== 'text' || leaf.tokens || typeof leaf.text !== 'string') return;
+		text.push(leaf.text);
+	}
+	if (text.length) paragraphs.set(key, text);
+}
