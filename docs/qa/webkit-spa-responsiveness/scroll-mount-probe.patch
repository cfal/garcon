+import { emptyScrollCounters } from '$lib/virt/virtual-list-scroll-counters';
+
+type Size = [width: number, height: number];
+type Table = Record<string, Size>;
+type Mode = 'normal' | 'retained' | 'light-rows';
+const host = typeof window === 'undefined' ? undefined : window as Window & {
+	__garconScrollProbeSizes?: Table;
+	__garconScrollProbe?: unknown;
+};
+const query = new URLSearchParams(host?.location.search);
+const selected = query.get('scrollProbe');
+export const scrollProbeMode: Mode =
+	selected === 'retained' || selected === 'light-rows' ? selected : 'normal';
+export const scrollProbeCounters = query.get('scrollProbeCounters') === '1'
+	? { ...emptyScrollCounters } : undefined;
+export const probeEntryLimit = 150;
+const table: Table = Object.create(null);
+function importSizes() {
+	const sizes = host?.__garconScrollProbeSizes;
+	if (!sizes) return;
+	for (const [key, size] of Object.entries(sizes)) {
+		if (Array.isArray(size) && size.length === 2 && Number.isFinite(size[0]) && size[0] > 0 &&
+			Number.isFinite(size[1]) && size[1] >= 0) table[key] = [size[0], size[1]];
+	}
+}
+let armed = false;
+
+export function enteringRowSize(key: string): Size | undefined {
+	if (!armed) return;
+	const size = table[key];
+	if (scrollProbeCounters) {
+		if (size) scrollProbeCounters.lightMounts++;
+		else scrollProbeCounters.lightMisses++;
+	}
+	return size;
+}
+
+function visibleSizers() {
+	return [...document.querySelectorAll<HTMLElement>('[data-chat-virtual-sizer]')].filter(
+		s => (s.closest<HTMLElement>('[data-chat-scroll-viewport]')?.clientHeight ?? 0) > 0,
+	);
+}
+function wrappers(sizer: HTMLElement) {
+	return [...sizer.querySelectorAll<HTMLElement>('[data-chat-virtual-item]')];
+}
+function info() {
+	return {
+		mode: scrollProbeMode, countersEnabled: Boolean(scrollProbeCounters), armed,
+		tableKeys: Object.keys(table).length, entryLimit: probeEntryLimit,
+		feeds: visibleSizers().map(s => {
+			const mounted = wrappers(s);
+			return {
+				entries: Number(s.dataset.chatTranscriptEntryCount), model: Number(s.dataset.chatVirtualModelCount),
+				mounted: mounted.length, placeholders: s.querySelectorAll('[data-scroll-probe-light]').length,
+				missingMountedSizes: scrollProbeMode === 'light-rows'
+					? mounted.filter(row => !table[row.dataset.chatVirtualItem!]).length : 0,
+			};
+		}),
+	};
+}
+if (host) host.__garconScrollProbe = {
+	info,
+	reset() { if (scrollProbeCounters) Object.assign(scrollProbeCounters, emptyScrollCounters); },
+	counters() { return scrollProbeCounters ? {...scrollProbeCounters} : null; },
+	capture() {
+		if (scrollProbeMode !== 'normal') throw Error('Collect sizes on a normal diagnostic page.');
+		for (const s of visibleSizers()) for (const row of wrappers(s)) {
+			const { width, height } = row.getBoundingClientRect();
+			if (width > 0) table[row.dataset.chatVirtualItem!] = [width, height];
+		}
+		return {...table};
+	},
+	arm() {
+		importSizes();
+		if (scrollProbeMode !== 'light-rows' || !Object.keys(table).length)
+			throw Error('Assign the captured normal table to window.__garconScrollProbeSizes before arm().');
+		const feeds = info().feeds;
+		if (feeds.length !== 1 || !feeds[0].mounted || feeds[0].entries > probeEntryLimit)
+			throw Error('Arm a single settled, visible synthetic feed of at most 150 entries.');
+		armed = true;
+		return info();
+	},
+	validate() {
+		let checked = 0, missing = 0, maxWidthError = 0, maxHeightError = 0;
+		for (const s of visibleSizers()) for (const row of wrappers(s)) {
+			const size = table[row.dataset.chatVirtualItem!];
+			if (!size) { missing++; continue; }
+			const { width, height } = row.getBoundingClientRect();
+			checked++;
+			maxWidthError = Math.max(maxWidthError, Math.abs(width - size[0]));
+			maxHeightError = Math.max(maxHeightError, Math.abs(height - size[1]));
+		}
+		return { checked, missing, maxWidthError, maxHeightError };
+	},
+};
