+// Only the isolated fixture arms this single assistant publication.
+export interface ReceiverPublicationTrial {
+	mode: 'immediate' | 'next-task';
+	chatId: string;
+	viewId: string;
+	userRowId: string;
+	expectedAssistant: string;
+	priorEntries: number;
+	priorRevision: number;
+	phase: 'armed' | 'waiting' | 'released' | 'applied' | 'invalid';
+	invalidReason?: string;
+	mark(stage: 'eligible' | 'task' | 'reconcile' | 'model' | 'published'): void;
+}
+
+export type ReceiverStudyWindow = Window & { __receiverTrial?: ReceiverPublicationTrial };
