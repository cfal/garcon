{
	"name": "garcon-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"browserslist": [
		"chrome >= 116",
		"edge >= 116",
		"firefox >= 124",
		"safari >= 17.4",
		"ios_saf >= 17.4"
	],
	"scripts": {
		"dev": "vite dev",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
		"build": "vite build && bun ../scripts/runtime-shell.ts && bun scripts/report-eager-assets.ts --check",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "bun run i18n:compile",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./src/service-worker/tsconfig.json --noEmit",
		"precheck:watch": "bun run i18n:compile",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "svelte-kit sync && eslint . --max-warnings=0",
		"profile:chat-ingestion": "bun scripts/benchmark-transcript-ingestion.ts",
		"profile:eager-assets": "bun run build && bun scripts/report-eager-assets.ts",
		"profile:sidebar-projection": "bun scripts/benchmark-sidebar-projection.ts",
		"profile:chat-board-projection": "bun scripts/benchmark-chat-board-projection.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.0",
		"@inlang/plugin-message-format": "4.5.4",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-go": "^6.0.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.14",
		"@garcon/common": "workspace:*",
		"@humanspeak/svelte-markdown": "^2.1.3",
		"@lezer/highlight": "^1.2.5",
		"@lucide/svelte": "^1.58.0",
		"@replit/codemirror-vim": "6.4.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tiptap/core": "3.32.0",
		"@tiptap/extension-blockquote": "3.32.0",
		"@tiptap/extension-bold": "3.32.0",
		"@tiptap/extension-code": "3.32.0",
		"@tiptap/extension-code-block": "3.32.0",
		"@tiptap/extension-document": "3.32.0",
		"@tiptap/extension-hard-break": "3.32.0",
		"@tiptap/extension-heading": "3.32.0",
		"@tiptap/extension-horizontal-rule": "3.32.0",
		"@tiptap/extension-image": "3.32.0",
		"@tiptap/extension-italic": "3.32.0",
		"@tiptap/extension-link": "3.32.0",
		"@tiptap/extension-list": "3.32.0",
		"@tiptap/extension-paragraph": "3.32.0",
		"@tiptap/extension-strike": "3.32.0",
		"@tiptap/extension-table": "3.32.0",
		"@tiptap/extension-text": "3.32.0",
		"@tiptap/extensions": "3.32.0",
		"@tiptap/markdown": "3.32.0",
		"@tiptap/pm": "3.32.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/svelte": "1.7.0",
		"bits-ui": "2.19.5",
		"clsx": "^2.1.1",
		"fuse.js": "^7.5.0",
		"katex": "^0.19.0",
		"marked": "^18.1.1",
		"mermaid": "^12.2.0",
		"tabbable": "^6.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	}
}
