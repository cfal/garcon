{
	"name": "garcon-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"browserslist": [
		"chrome >= 116",
		"edge >= 116",
		"firefox >= 124",
		"safari >= 17.4",
		"ios_saf >= 17.4"
	],
	"scripts": {
		"dev": "vite dev",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "bun run i18n:compile",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"precheck:watch": "bun run i18n:compile",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "svelte-kit sync && eslint . --max-warnings=0",
		"profile:chat-ingestion": "bun scripts/benchmark-transcript-ingestion.ts",
		"profile:eager-assets": "bun run build && bun scripts/report-eager-assets.ts",
		"profile:sidebar-projection": "bun scripts/benchmark-sidebar-projection.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vite-bundle-analyzer": "^1.3.9",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-go": "^6.0.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.11",
		"@garcon/common": "workspace:*",
		"@humanspeak/svelte-markdown": "^1.9.0",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.41.0",
		"@tailwindcss/typography": "^0.5.20",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"fuse.js": "^7.5.0",
		"katex": "^0.18.6",
		"marked": "^18.0.11",
		"mermaid": "^11.17.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	}
}
