      "http": {
        "method": "GET",
        "path": "/api/v1/executors"
      }
    },
    {
      "name": "create-empty-body",
      "http": {
        "method": "POST",
        "path": "/api/v1/executors",
        "json": {}
      }
    },
    {
      "name": "create-array-body",
      "http": {
        "method": "POST",
        "path": "/api/v1/executors",
        "json": [
          "x"
        ]
      }
    },
    {
