{
  "name": "terminals",
  "description": "Empty terminal listings and terminal request, executor, and runtime validation without starting a shell.",
  "traps": true,
  "steps": [
    { "name": "list-empty", "http": { "method": "GET", "path": "/api/v1/terminals" } },
    { "name": "list-local", "http": { "method": "GET", "path": "/api/v1/terminals?executorId=local" } },
    { "name": "list-executor-invalid", "http": { "method": "GET", "path": "/api/v1/terminals?executorId=remote" } },
    { "name": "list-executor-empty", "http": { "method": "GET", "path": "/api/v1/terminals?executorId=" } },
    { "name": "list-executor-first-of-repeated", "http": { "method": "GET", "path": "/api/v1/terminals?executorId=local&executorId=remote" } },
    { "name": "list-executor-unavailable", "http": { "method": "GET", "path": "/api/v1/terminals?executorId=33333333-3333-4333-8333-333333333333" } },
    { "name": "create-body-not-object", "http": { "method": "POST", "path": "/api/v1/terminals", "json": [] } },
    { "name": "create-request-id-missing", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestedInitialWorkingDirectory": null } } },
    { "name": "create-request-id-blank", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "   ", "requestedInitialWorkingDirectory": null } } },
    { "name": "create-request-id-not-string", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": 1, "requestedInitialWorkingDirectory": null } } },
    { "name": "create-request-id-too-long", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "requestedInitialWorkingDirectory": null } } },
    { "name": "create-project-path-missing", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic" } } },
    { "name": "create-project-path-not-string", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": 7 } } },
    { "name": "create-executor-invalid", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null, "executorId": "remote" } } },
    { "name": "create-executor-null", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null, "executorId": null } } },
    { "name": "create-executor-unavailable", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null, "executorId": "33333333-3333-4333-8333-333333333333" } } },
    { "name": "create-runtime-id-missing", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null } } },
    { "name": "create-runtime-id-blank", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null, "expectedTerminalRuntimeId": " " } } },
    { "name": "create-runtime-id-not-string", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null, "expectedTerminalRuntimeId": 7 } } },
    { "name": "create-runtime-id-too-long", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "synthetic", "requestedInitialWorkingDirectory": null, "expectedTerminalRuntimeId": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } } },
    { "name": "create-stale-runtime-with-max-request-id", "http": { "method": "POST", "path": "/api/v1/terminals", "json": { "requestId": "rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr", "requestedInitialWorkingDirectory": "{{projectDir}}", "expectedTerminalRuntimeId": "44444444-4444-4444-8444-444444444444" } } },
    { "name": "rename-terminal-id-missing", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "title": "Example" } } },
    { "name": "rename-terminal-id-not-string", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": 7, "title": "Example" } } },
    { "name": "rename-terminal-id-too-long", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "title": "Example" } } },
    { "name": "rename-terminal-reference-invalid", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "bad-reference", "title": "Example" } } },
    { "name": "rename-title-missing", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty" } } },
    { "name": "rename-title-not-string", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty", "title": 7 } } },
    { "name": "rename-title-control-character", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty", "title": "Line\nBreak" } } },
    { "name": "rename-title-too-long", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty", "title": "ttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt" } } },
    { "name": "rename-executor-unavailable", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "33333333-3333-4333-8333-333333333333/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555", "title": "Example" } } },
    { "name": "rename-runtime-stale", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "local/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555", "title": "Example" } } },
    { "name": "rename-terminal-not-found-in-current-runtime", "http": { "method": "PATCH", "path": "/api/v1/terminals", "json": { "terminalId": "local/{{list-empty.body.terminalRuntimeId}}/55555555-5555-4555-8555-555555555555", "title": null } } },
    { "name": "terminate-terminal-id-missing", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "requestId": "synthetic" } } },
    { "name": "terminate-terminal-id-blank", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "  ", "requestId": "synthetic" } } },
    { "name": "terminate-terminal-id-too-long", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "requestId": "synthetic" } } },
    { "name": "terminate-terminal-reference-invalid", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "bad-reference", "requestId": "synthetic" } } },
    { "name": "terminate-request-id-missing", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty" } } },
    { "name": "terminate-request-id-not-string", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty", "requestId": 7 } } },
    { "name": "terminate-request-id-too-long", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "nonempty", "requestId": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } } },
    { "name": "terminate-executor-unavailable", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "33333333-3333-4333-8333-333333333333/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555", "requestId": "synthetic" } } },
    { "name": "terminate-runtime-stale", "http": { "method": "DELETE", "path": "/api/v1/terminals", "json": { "terminalId": "local/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555", "requestId": "synthetic" } } },
    { "name": "list-after-rejected-operations", "http": { "method": "GET", "path": "/api/v1/terminals?executorId=local" } },
    { "name": "wrong-method", "http": { "method": "PUT", "path": "/api/v1/terminals", "json": {} } }
  ]
}
