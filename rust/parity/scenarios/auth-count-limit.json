{
  "name": "auth-count-limit",
  "description": "The auth rate limits, each on a fresh server: ten registrations a minute, ten credential changes a minute shared by both credential routes, thirty logouts a minute counted before the token is verified, and ten sign-ins a minute that also stop a correct one. The allowed requests are accepted-boundary inputs: identifiers at the limit, a trimmed username, and a body of exactly 4096 bytes.",
  "steps": [
    {
      "name": "register-password-8-characters",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/register",
        "json": {
          "username": "newuser",
          "password": "12345678"
        },
        "auth": "none"
      }
    },
    {
      "name": "register-password-128-characters",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/register",
