{
  "name": "auth-password",
  "description": "Changing the password: field validation in check order, the unchanged and wrong-password errors, and the request refused without a token or with a forged one.",
  "steps": [
    {
      "name": "password-empty-object",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {}
      }
    },
    {
      "name": "password-current-password-129-characters",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp",
          "newPassword": "another-password-123"
        }
      }
    },
    {
      "name": "password-new-password-missing",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}"
        }
      }
    },
    {
      "name": "password-new-password-not-string",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": 42
        }
      }
    },
    {
      "name": "password-new-password-7-characters",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "1234567"
        }
      }
    },
    {
      "name": "password-new-password-129-characters",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
        }
      }
    },
    {
      "name": "password-wrong-password",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "wrong-password",
          "newPassword": "another-password-123"
        }
      }
    },
    {
      "name": "password-unchanged",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "{{password}}"
        }
      }
    },
    {
      "name": "password-unchanged-with-wrong-password",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "wrong-password",
          "newPassword": "wrong-password"
        }
      }
    },
    {
      "name": "password-without-token",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "another-password-123"
        },
        "auth": "none"
      }
    },
    {
      "name": "password-with-forged-token",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "another-password-123"
        },
        "auth": "forged"
      }
    },
    {
      "name": "password-wrong-method",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/password",
        "json": {},
        "auth": "none"
      }
    },
    {
      "name": "user-after-failed-changes",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user"
      }
    }
  ],
  "traps": false
}
