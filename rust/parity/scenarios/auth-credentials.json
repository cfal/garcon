{
  "name": "auth-credentials",
  "description": "Successful username and password changes: each answers with a new token for the same session, every earlier token is refused, the old password stops working, a sign-in does not trim the username, a stale token logs out only its own session, and a logout revokes its session.",
  "steps": [
    {
      "name": "user-before",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user"
      }
    },
    {
      "name": "rename-username",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/username",
        "json": {
          "currentPassword": "{{password}}",
          "username": "renamed"
        }
      }
    },
    {
      "name": "user-with-previous-token",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user"
      }
    },
    {
      "name": "rename-again-with-previous-token",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/username",
        "json": {
          "currentPassword": "{{password}}",
          "username": "renamed-again"
        }
      }
    },
    {
      "name": "user-with-username-token",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-username.body.token}}"
        }
      }
    },
    {
      "name": "rename-unchanged",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/username",
        "json": {
          "currentPassword": "{{password}}",
          "username": " renamed "
        },
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-username.body.token}}"
        }
      }
    },
    {
      "name": "rename-wrong-password",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/username",
        "json": {
          "currentPassword": "wrong-password",
          "username": "renamed-again"
        },
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-username.body.token}}"
        }
      }
    },
    {
      "name": "change-password",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "another-password-123"
        },
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-username.body.token}}"
        }
      }
    },
    {
      "name": "user-with-username-token-after-password-change",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-username.body.token}}"
        }
      }
    },
    {
      "name": "user-with-password-token",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{change-password.body.token}}"
        }
      }
    },
    {
      "name": "password-unchanged",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "another-password-123",
          "newPassword": "another-password-123"
        },
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{change-password.body.token}}"
        }
      }
    },
    {
      "name": "password-wrong-password",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/password",
        "json": {
          "currentPassword": "{{password}}",
          "newPassword": "third-password-123"
        },
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{change-password.body.token}}"
        }
      }
    },
    {
      "name": "login-with-old-password",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "json": {
          "username": "renamed",
          "password": "{{password}}"
        },
        "auth": "none"
      }
    },
    {
      "name": "login-with-old-username",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "json": {
          "username": "parity",
          "password": "another-password-123"
        },
        "auth": "none"
      }
    },
    {
      "name": "login-with-padded-username",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "json": {
          "username": " renamed ",
          "password": "another-password-123"
        },
        "auth": "none"
      }
    },
    {
      "name": "login-with-new-credentials",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "json": {
          "username": "renamed",
          "password": "another-password-123"
        },
        "auth": "none"
      }
    },
    {
      "name": "user-with-login-token",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{login-with-new-credentials.body.token}}"
        }
      }
    },
    {
      "name": "user-with-first-session-token",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{change-password.body.token}}"
        }
      }
    },
    {
      "name": "rename-back",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/auth/username",
        "json": {
          "currentPassword": "another-password-123",
          "username": "parity"
        },
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{login-with-new-credentials.body.token}}"
        }
      }
    },
    {
      "name": "user-with-rename-back-token",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-back.body.token}}"
        }
      }
    },
    {
      "name": "user-with-first-session-after-rename-back",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{change-password.body.token}}"
        }
      }
    },
    {
      "name": "user-with-login-token-after-rename-back",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{login-with-new-credentials.body.token}}"
        }
      }
    },
    {
      "name": "logout-with-stale-token",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/logout"
      }
    },
    {
      "name": "user-with-other-session-after-stale-logout",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-back.body.token}}"
        }
      }
    },
    {
      "name": "logout",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/logout",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-back.body.token}}"
        }
      }
    },
    {
      "name": "user-after-logout",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/user",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-back.body.token}}"
        }
      }
    },
    {
      "name": "logout-revoked-token",
      "http": {
        "method": "POST",
        "path": "/api/v1/auth/logout",
        "auth": "none",
        "headers": {
          "Authorization": "Bearer {{rename-back.body.token}}"
        }
      }
    },
    {
      "name": "status-at-end",
      "http": {
        "method": "GET",
        "path": "/api/v1/auth/status",
        "auth": "none"
      }
    }
  ],
  "traps": false
}
