{
  "name": "executors-seeded",
  "description": "Executor configuration routes over three seeded executors, one disabled and one without TLS: unknown identifiers; label updates with the duplicate, reserved and freed names; flag updates; disabling and enabling; address updates, where a full connection URL carries the secret that replaces the executor's own; the connection URL with an advertised address, without one, and without TLS; and remove.",
  "server": {
    "files": {
      "workspace/api-provider-assignments.json": "{\"version\":1,\"revision\":0,\"assignments\":{}}",
      "workspace/workspace-version.json": "{\n  \"version\": 10\n}\n",
      "workspace/executors.json": "{\n  \"version\": 1,\n  \"executors\": [\n    {\n      \"id\": \"11111111-1111-4111-8111-111111111111\",\n      \"label\": \"Executor One\",\n      \"enabled\": true,\n      \"noTls\": false,\n      \"allowControllerCli\": true,\n      \"allowExecutorManagement\": true,\n      \"allowUnverifiedTls\": false,\n      \"secret\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQ\",\n      \"connection\": {\n        \"kind\": \"executor-connects\",\n        \"advertisedUrl\": \"wss://executor-one.example.invalid/link\"\n      }\n    },\n    {\n      \"id\": \"22222222-2222-4222-8222-222222222222\",\n      \"label\": \"Executor Two\",\n      \"enabled\": false,\n      \"noTls\": false,\n      \"allowControllerCli\": false,\n      \"allowExecutorManagement\": false,\n      \"allowUnverifiedTls\": false,\n      \"secret\": \"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBAQ\",\n      \"connection\": {\n        \"kind\": \"executor-connects\",\n        \"advertisedUrl\": null\n      }\n    },\n    {\n      \"id\": \"33333333-3333-4333-8333-333333333333\",\n      \"label\": \"Executor Three\",\n      \"enabled\": true,\n      \"noTls\": true,\n      \"allowControllerCli\": false,\n      \"allowExecutorManagement\": false,\n      \"allowUnverifiedTls\": false,\n      \"secret\": \"CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCQ\",\n      \"connection\": {\n        \"kind\": \"executor-connects\",\n        \"advertisedUrl\": \"ws://executor-three.example.invalid/link\"\n      }\n    }\n  ]\n}"
    }
  },
