      }
    },
    {
      "name": "usage-executor-invalid",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=UTC&executorId=remote"
      }
    },
    {
      "name": "usage-executor-unknown",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=UTC&executorId=33333333-3333-4333-8333-333333333333"
      }
    },
    {
      "name": "usage-executor-duplicated",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=UTC&executorId=local&executorId=local"
      }
    },
    {
      "name": "usage-executor-local",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=UTC&executorId=local"
      }
    },
    {
      "name": "usage-seven-days",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=UTC"
      }
    },
    {
      "name": "usage-one-day",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{today}}&untilDay={{today}}&timeZone=UTC"
      }
    },
    {
      "name": "usage-in-new-york",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=America%2FNew_York"
      }
    },
    {
      "name": "usage-in-kathmandu",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=Asia%2FKathmandu"
      }
    },
    {
      "name": "usage-with-offset-zone",
      "http": {
        "method": "GET",
        "path": "/api/v1/usage?sinceDay={{todayMinus6}}&untilDay={{today}}&timeZone=UTC%2B05:30"
      }
    },
    {
      "name": "usage-wrong-method",
      "http": {
        "method": "POST",
        "path": "/api/v1/usage"
      }
    }
  ],
  "traps": true
}
