{
  "name": "chat-boards-seeded",
  "description": "Chat board routes over a seeded catalog with columns: update successes including name normalization, catalog-level column and name uniqueness, the column count limit, revision conflicts that return the catalog, remove, and reorder.",
  "server": {
    "files": {
      "workspace/api-provider-assignments.json": "{\"version\":1,\"revision\":0,\"assignments\":{}}",
      "workspace/workspace-version.json": "{\n  \"version\": 10\n}\n",
      "workspace/chat-boards.json": "{\n  \"version\": 1,\n  \"revision\": 9,\n  \"boards\": [\n    {\n      \"id\": \"11111111-1111-4111-8111-111111111111\",\n      \"name\": \"Board A\",\n      \"columns\": [\n        {\n          \"id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n          \"name\": \"To do\",\n          \"match\": \"all\",\n          \"tags\": [\n            \"todo\"\n          ]\n        },\n        {\n          \"id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n          \"name\": \"Doing\",\n          \"match\": \"any\",\n          \"tags\": [\n            \"doing\",\n            \"review\"\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"22222222-2222-4222-8222-222222222222\",\n      \"name\": \"Board B\",\n      \"columns\": []\n    }\n  ]\n}\n"
    }
  },
