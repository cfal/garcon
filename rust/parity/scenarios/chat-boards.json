{
  "name": "chat-boards",
  "description": "Chat board routes on an empty workspace: reads, create validation field by field, name normalization at the length limit, revision conflicts with the returned catalog, unknown board identifiers, every reorder rejection, and an update, a reorder, and a remove of the created boards by the identifiers their creates answered with.",
  "steps": [
    {
      "name": "boards-empty",
      "http": {
        "method": "GET",
        "path": "/api/v1/chat-boards"
      }
    },
    {
      "name": "create-missing-revision",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "name": "Board"
        }
      }
    },
    {
      "name": "create-missing-name",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": 0
        }
      }
    },
    {
      "name": "create-extra-key",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": 0,
          "name": "Board",
          "extra": true
        }
      }
    },
    {
      "name": "create-revision-negative",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": -1,
          "name": "Board"
        }
      }
    },
    {
      "name": "create-revision-fractional",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": 0.5,
          "name": "Board"
        }
      }
    },
    {
      "name": "create-revision-string",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": "0",
          "name": "Board"
        }
      }
    },
    {
      "name": "create-revision-null",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": null,
          "name": "Board"
        }
      }
    },
    {
      "name": "create-name-not-string",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": 0,
          "name": 42
        }
      }
    },
    {
      "name": "create-array-body",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": [
          "Board"
        ]
      }
    },
    {
      "name": "create-scalar-body",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": "Board"
      }
    },
    {
      "name": "create-name-blank",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": 0,
          "name": "   "
        }
      }
    },
    {
      "name": "create-name-81-code-points",
      "http": {
        "method": "POST",
        "path": "/api/v1/chat-boards",
        "json": {
          "expectedRevision": 0,
          "name": "ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"
