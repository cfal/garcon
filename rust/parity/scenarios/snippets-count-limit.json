  "steps": [
    {
      "name": "create-at-limit",
      "http": {
        "method": "POST",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 40,
          "snippet": {
            "shortName": "overflow",
            "template": "Run overflow",
            "defaultArguments": ""
          }
        }
      }
    },
    {
      "name": "create-at-limit-invalid-definition",
      "http": {
        "method": "POST",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 40,
          "snippet": {
            "shortName": "BAD",
            "template": "Run BAD",
            "defaultArguments": ""
          }
        }
      }
    },
    {
      "name": "create-at-limit-stale-revision",
      "http": {
        "method": "POST",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 39,
          "snippet": {
            "shortName": "overflow",
            "template": "Run overflow",
            "defaultArguments": ""
          }
        }
      }
    },
    {
      "name": "update-at-limit",
      "http": {
        "method": "PUT",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 40,
          "id": "full-snippet-100",
          "snippet": {
            "shortName": "s100",
            "template": "Changed",
            "defaultArguments": ""
          }
        }
      }
    },
    {
      "name": "create-duplicate-at-limit",
      "http": {
        "method": "POST",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 41,
          "snippet": {
            "shortName": "s100",
            "template": "Run s100",
            "defaultArguments": ""
          }
        }
      }
    },
    {
      "name": "remove-at-limit",
      "http": {
        "method": "DELETE",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 41,
          "id": "full-snippet-050"
        }
      }
    },
    {
      "name": "snippets-below-limit",
      "http": {
        "method": "GET",
        "path": "/api/v1/snippets"
      }
    },
    {
      "name": "create-after-remove",
      "http": {
        "method": "POST",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 42,
          "snippet": {
            "shortName": "overflow",
            "template": "Run overflow",
            "defaultArguments": ""
          }
        }
      }
    },
    {
      "name": "remove-again-below-limit",
      "http": {
        "method": "DELETE",
        "path": "/api/v1/snippets",
        "json": {
          "expectedRevision": 43,
          "id": "full-snippet-051"
        }
      }
    }
  ],
  "traps": true
