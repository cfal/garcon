{
  "scenario": "auth-seeded",
  "cases": [
    {
      "name": "status-seeded",
      "expected": {
        "body": {
          "kind": "json",
          "value": {
            "authDisabled": false,
            "isAuthenticated": false,
            "needsSetup": false
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-encoding": "gzip",
          "content-type": "application/json;charset=utf-8",
          "vary": "Accept-Encoding"
        },
        "request": {
          "auth": "none",
          "method": "GET",
          "path": "/api/v1/auth/status"
        },
        "status": 200
      },
      "noise": []
    },
    {
      "name": "login-below-session-limit",
      "expected": {
        "body": {
          "kind": "json",
          "value": {
            "success": true,
            "token": "{{jwt}}",
            "user": {
              "id": "parity",
              "username": "parity"
            }
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-encoding": "gzip",
          "content-type": "application/json;charset=utf-8",
          "vary": "Accept-Encoding"
        },
        "request": {
          "auth": "none",
          "method": "POST",
          "path": "/api/v1/auth/login"
        },
        "status": 200
      },
      "noise": []
    },
    {
      "name": "login-at-session-limit",
      "expected": {
        "body": {
          "kind": "json",
          "value": {
            "error": "Too many active browser sessions. Log out an existing session or wait for it to expire.",
            "errorCode": "AUTH_BUSY",
            "retryable": false,
            "success": false
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-encoding": "gzip",
          "content-type": "application/json;charset=utf-8",
          "retry-after": "5",
          "vary": "Accept-Encoding"
        },
        "request": {
          "auth": "none",
          "method": "POST",
          "path": "/api/v1/auth/login"
        },
        "status": 429
      },
      "noise": []
    },
