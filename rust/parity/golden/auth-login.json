            "error": "A JSON body is required.",
            "errorCode": "AUTH_VALIDATION_FAILED",
            "retryable": false,
            "success": false
          }
        },
        "headers": {
          "cache-control": "no-store",
          "content-encoding": "gzip",
          "content-type": "application/json;charset=utf-8",
          "vary": "Accept-Encoding"
        },
        "request": {
